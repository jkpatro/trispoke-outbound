# Keep the build context small and avoid leaking secrets.
.venv/
data/
__pycache__/
**/__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Git / IDE
.git/
.gitignore
.vscode/
.idea/

# Local-only files
.env                 # never bake secrets into the image; compose reads from host
*.log
*.db
*.sqlite

# Build artifacts
dist/
build/
*.egg-info/

# Don't need install scripts inside the image
scripts/install_*.sh
scripts/install_*.ps1
scripts/run_*
scripts/stop.*
