# ===== REQUIRED — Supabase Auth (email + password) + DB =====
# Get URL + anon key from Supabase Dashboard → Project Settings → API.
# SUPABASE_ANON_KEY accepts EITHER the modern publishable key
# (sb_publishable_...) OR the legacy anon JWT (eyJ...).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=

# Service-role secret (Supabase → Project Settings → API → service_role).
# Server-side ONLY — never shipped to the browser. Required so admins can reset
# other users' passwords and so self-signup can provision accounts without an
# email-confirmation round-trip. Treat it like a root credential.
SUPABASE_SERVICE_ROLE_KEY=

# Supabase Postgres direct-connection URL (psycopg driver).
# URL-encode `@` in the password as %40.
DATABASE_URL=postgresql+psycopg://postgres:YOUR_DB_PASSWORD@db.YOUR-PROJECT.supabase.co:5432/postgres

# ===== REQUIRED — secret-store encryption =====
# Fernet key used to encrypt every value in the `app_secrets` table.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Treat it like a master password — anyone with this key can decrypt
# anything in app_secrets. Regenerating it makes ALL stored secrets unreadable.
TRISPOKE_SECRET_KEY=

# ===== EVERYTHING ELSE (Apollo / Anthropic / Abacus / SMTP / IMAP / webhooks) =====
# Configure these once via the in-app Settings page after signing in. They get
# Fernet-encrypted before they touch Supabase. The DB column shows ciphertext
# only — your raw keys are never readable from the database.
#
# Legacy env vars below are still picked up by the resolver as a fallback during
# migration, but the in-app Settings flow is the supported path.

# ----- Ollama (local generation — runs on your machine, no key needed) -----
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ----- Apollo non-secret configuration -----
APOLLO_POLL_INTERVAL_SECONDS=900
APOLLO_MAX_ENROLLMENTS_PER_MINUTE=25
# APOLLO_DEFAULT_SEQUENCE_MAILBOX_IDS=mb1,mb2

# ----- Automation guardrails -----
BOUNCE_PAUSE_THRESHOLD=0.03
BOUNCE_PAUSE_MIN_SENDS=20

# ----- Abacus non-secret configuration -----
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_MODEL=route-llm

# ----- Legacy SMTP non-secret config -----
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=

# Send limits (legacy SMTP path only)
DAILY_CAP_PER_INBOX=20

# ----- SQLite fallback -----
DATABASE_PATH=./data/trispoke.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ----- Postgres (Docker stack only — composed by docker-compose.yml) -----
POSTGRES_USER=trispoke
POSTGRES_PASSWORD=changeme-please
POSTGRES_DB=trispoke
