# ===== REQUIRED =====
APOLLO_API_KEY=your_apollo_key

# ===== OPTIONAL — LLMs =====
# Anthropic (used by Claude direct and Hybrid modes). Leave blank for local-only.
ANTHROPIC_API_KEY=
# Abacus.AI RouteLLM (ChatLLM Teams subscription required). Leave blank to disable.
ABACUS_API_KEY=
ABACUS_BASE_URL=https://routellm.abacus.ai/v1
ABACUS_MODEL=route-llm

# Ollama (local-mode generation + QC). Required for local/hybrid modes and QC.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ===== APOLLO SEND/RECEIVE (V1.5 Apollo-out) =====
APOLLO_POLL_INTERVAL_SECONDS=900
APOLLO_MAX_ENROLLMENTS_PER_MINUTE=25
# Optional: comma-separated Apollo mailbox IDs. If empty, the push worker
# picks the first active mailbox returned by Apollo.
# APOLLO_DEFAULT_SEQUENCE_MAILBOX_IDS=mb1,mb2

# ===== LEGACY: direct-SMTP sending =====
# Only needed if you create a campaign with sending_mode='smtp_direct'.
# Apollo-mode campaigns ignore everything in this section.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
IMAP_HOST=
IMAP_PORT=993
IMAP_USERNAME=
IMAP_PASSWORD=

# Limits (legacy SMTP path only)
DAILY_CAP_PER_INBOX=20

# ----- Database -----
# Bare-metal dev: leave DATABASE_URL blank, the app falls back to SQLite at
# DATABASE_PATH. Docker prod: docker-compose.yml composes the Postgres URL
# from POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB and injects it as
# DATABASE_URL into every service.
DATABASE_URL=
DATABASE_PATH=./data/trispoke.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

# ----- Postgres (Docker only) -----
POSTGRES_USER=trispoke
POSTGRES_PASSWORD=changeme-please
POSTGRES_DB=trispoke